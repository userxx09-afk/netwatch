<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Single App Mode (App Lock) for the NetWatch app. Supervised iPads only.
     Most MDMs (Jamf, Intune, Kandji, Mosyle...) have a "Single App Mode / App Lock" UI
     that produces this same payload; use this as a reference for the settings. -->
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key><string>com.apple.app.lock</string>
      <key>PayloadIdentifier</key><string>com.example.netwatch.applock</string>
      <key>PayloadUUID</key><string>530F56B1-8F8C-41A7-997F-247CEB04BD86</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadDisplayName</key><string>NetWatch Single App Mode</string>
      <key>App</key>
      <dict>
        <!-- must match PRODUCT_BUNDLE_IDENTIFIER (or your kiosk app's bundle ID) -->
        <key>Identifier</key><string>com.example.netwatch</string>
        <key>Options</key>
        <dict>
          <!-- Screen sleep powers Wi-Fi down and suspends the app. Keep the kiosk awake. -->
          <key>DisableAutoLock</key><true/>
          <key>DisableSleepWakeButton</key><false/>
          <key>DisableVolumeButtons</key><false/>
        </dict>
      </dict>
    </dict>
  </array>
  <key>PayloadType</key><string>Configuration</string>
  <key>PayloadIdentifier</key><string>com.example.netwatch.applock.profile</string>
  <key>PayloadUUID</key><string>E5964214-CDA4-4489-B6F5-A892B3FBE947</string>
  <key>PayloadVersion</key><integer>1</integer>
  <key>PayloadDisplayName</key><string>NetWatch Kiosk</string>
</dict>
</plist>
